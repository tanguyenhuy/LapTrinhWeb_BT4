<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<head>
    <title>Danh Sách Tất Cả Sản Phẩm</title>
</head>
<body>
    <!-- Điều hướng Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="${pageContext.request.contextPath}/home" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tất cả sản phẩm</li>
        </ol>
    </nav>

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h3 class="fw-bold text-primary m-0">
            <i class="bi bi-grid-fill me-2"></i>DANH SÁCH TẤT CẢ SẢN PHẨM
        </h3>
    </div>

    <!-- Danh sách sản phẩm dạng Grid Bootstrap (3 cột trên desktop) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        <c:forEach items="${listProduct}" var="p">
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <a href="${pageContext.request.contextPath}/product/detail?id=${p.productId}" class="text-decoration-none text-dark">
                        <!-- Hiển thị cả ảnh online lẫn ảnh upload nội bộ -->
                        <c:choose>
                            <c:when test="${p.image != null && p.image.startsWith('http')}">
                                <img src="${p.image}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="${p.productName}">
                            </c:when>
                            <c:otherwise>
                                <img src="${pageContext.request.contextPath}/image?fname=${p.image}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="${p.productName}">
                            </c:otherwise>
                        </c:choose>

                        <!-- Dùng thẻ span + class d-block để tránh cảnh báo vàng Eclipse -->
                        <span class="d-block card-body p-3 text-center">
                            <span class="d-block card-title text-truncate fw-bold mb-2 fs-5">${p.productName}</span>
                            <span class="d-block card-text text-danger fw-bold fs-5">${p.price} VNĐ</span>
                        </span>
                    </a>
                </div>
            </div>
        </c:forEach>
    </div>

    <!-- Phân trang Bootstrap 5 -->
    <c:if test="${totalPages > 1}">
        <nav class="mt-5 d-flex justify-content-center" aria-label="Page navigation">
            <ul class="pagination shadow-sm">
                <!-- Nút trang trước -->
                <li class="page-item ${currentPage <= 1 ? 'disabled' : ''}">
                    <a class="page-link" href="${pageContext.request.contextPath}/product?page=${currentPage - 1}" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                <!-- Danh sách các trang -->
                <c:forEach begin="1" end="${totalPages}" var="i">
                    <li class="page-item ${currentPage == i ? 'active' : ''}">
                        <a class="page-link" href="${pageContext.request.contextPath}/product?page=${i}">${i}</a>
                    </li>
                </c:forEach>

                <!-- Nút trang sau -->
                <li class="page-item ${currentPage >= totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="${pageContext.request.contextPath}/product?page=${currentPage + 1}" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    </c:if>
</body>