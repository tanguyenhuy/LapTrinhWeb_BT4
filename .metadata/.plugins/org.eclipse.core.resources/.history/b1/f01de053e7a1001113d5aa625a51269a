package huytan.vn.configs;

import jakarta.persistence.EntityManager;
import jakarta.persistence.EntityTransaction;
import huytan.vn.entities.Category;
import huytan.vn.entities.Video;

public class TestJPA {
    public static void main(String[] args) {
        EntityManager enma = JpaConfig.getEntityManager();
        EntityTransaction trans = enma.getTransaction();

        Category cate = new Category();
        cate.setCategoryname("Iphone");
        cate.setImages("iphone.jpg");
        cate.setStatus(1);

        Video video = new Video();
        video.setVideoId("v01");
        video.setTitle("Review iPhone 16 :))");
        video.setActive(1);
        video.setCategory(cate);

        try {
            trans.begin();
            enma.persist(cate);
            enma.persist(video);
            trans.commit();
            System.out.println(">>> CẤU HÌNH & GHI DỮ LIỆU JPA THÀNH CÔNG! <<<");
        } catch (Exception e) {
            e.printStackTrace();
            if (trans.isActive()) trans.rollback();
        } finally {
            enma.close();
        }
    }
}