<!-- forgot-password.jsp -->
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<!DOCTYPE html>
<html>
<head><title>Quên mật khẩu</title></head>
<body style="font-family: Arial; padding: 20px;">
    <h2>QUÊN MẬT KHẨU</h2>
    <c:if test="${error != null}"><p style="color: red;">${error}</p></c:if>
    <form action="${pageContext.request.contextPath}/forgot-password" method="post" style="width: 300px;">
        <p>Nhập email đăng ký: <input type="email" name="email" required style="width: 100%;"></p>
        <button type="submit">Gửi mã OTP qua Mail</button>
    </form>
</body>
</html>